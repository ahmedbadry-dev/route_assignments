#!/bin/sh

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf '%s\n' "Direct pushes to main are blocked." >&2
    printf '%s\n' "Push your assignment branch and merge development into main using a pull request." >&2
    exit 1
  fi
done

exit 0
